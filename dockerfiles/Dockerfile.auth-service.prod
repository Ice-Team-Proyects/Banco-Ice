# Production Dockerfile for auth-service (Render)
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy the solution file and project files to restore dependencies
COPY AuthService.sln ./
COPY src/AuthService.Domain/AuthService.Domain.csproj src/AuthService.Domain/
COPY src/AuthService.Persistence/AuthService.Persistence.csproj src/AuthService.Persistence/
COPY src/AuthService.Application/AuthService.Application.csproj src/AuthService.Application/
COPY src/AuthService.Api/AuthService.Api.csproj src/AuthService.Api/

RUN dotnet restore AuthService.sln

# Copy the rest of the source code and publish in Release mode
COPY src/ src/
RUN dotnet publish src/AuthService.Api/AuthService.Api.csproj -c Release -o /app/publish --no-restore

# Stage 2: Runtime Image
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .

# Install curl for optional health checks
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Set ASPNETCORE_ENVIRONMENT to Production
ENV ASPNETCORE_ENVIRONMENT=Production

# Bind to the dynamic $PORT provided by Render at runtime
CMD ["sh", "-c", "dotnet AuthService.Api.dll --urls http://+:${PORT}"]
