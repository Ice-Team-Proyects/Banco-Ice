# client-userICE/.env.example
# Copia este archivo como .env y ajusta las URLs a tu entorno.
#
# - Emulador Android: usa 10.0.2.2 en lugar de localhost (localhost apunta al propio emulador).
# - Simulador iOS: localhost funciona directamente.
# - Dispositivo físico: usa la IP LAN de tu máquina (p. ej. http://192.168.0.10:5210/...).

# Nota: el registro corre en el mismo auth service que el login (5210).
EXPO_PUBLIC_AUTH_LOGIN_URL=http://10.0.2.2:5210/api/v1/auth
EXPO_PUBLIC_AUTH_REGISTER_URL=http://10.0.2.2:5210/api/v1/auth
EXPO_PUBLIC_BANKING_URL=http://10.0.2.2:3050/BankingService/v1
